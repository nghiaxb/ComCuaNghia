{
  "name": "com-cua-nghia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["global_fetch_strictly_public"],
}
