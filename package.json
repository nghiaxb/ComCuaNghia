    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.49.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vietnam-qr-pay": "1.5.1",
    "zod": "4.6.5"
