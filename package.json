{
  "name": "com-cua-nghia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,shared,worker,tests}/**/*.{ts,tsx,css,html}\" \"*.{ts,mjs,json,jsonc}\" \"scripts/*.mjs\" \".github/workflows/*.yml\" \"README.md\"",
    "format:check": "prettier --check \"{src,shared,worker,tests}/**/*.{ts,tsx,css,html}\" \"*.{ts,mjs,json,jsonc}\" \"scripts/*.mjs\" \".github/workflows/*.yml\" \"README.md\""
  },
